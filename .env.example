# Consumer Key from your Salesforce External Client App / Connected App.
# Leave empty to sign in with your Salesforce CLI (sf) login instead.
SF_CLIENT_ID=

# CLI login only: the org alias or username to use (default: the CLI's default org)
SF_TARGET_ORG=

# CLI login only: full path to sf if it isn't on your PATH
SF_CLI_PATH=

# Only needed if your app is set to require a secret for the Web Server flow
SF_CLIENT_SECRET=

# Use https://test.salesforce.com for a sandbox, or your My Domain login URL
SF_LOGIN_URL=https://login.salesforce.com

SF_API_VERSION=v62.0
PORT=3000

# Optional: the HTTPS port for the Outlook add-in, used once `sh scripts/outlook-cert.sh` has made a certificate (see docs/OUTLOOK.md)
HTTPS_PORT=3443

# Optional: any long random string (otherwise one is generated each start)
SESSION_SECRET=

# Optional: API name of the "Lead SE" field on Account/Opportunity (found by label if left empty)
SF_LEAD_SE_FIELD=

# Optional: where the local SQLite copy of your records is kept (default: ./data/sf-desk.db)
SF_DESK_DB=

# Optional: the Deal Support object's API name, if finding it by its label "Deal Support" doesn't work
SF_DEAL_SUPPORT_OBJECT=

# Optional: its lookup field to Opportunity, if it has more than one
SF_DEAL_SUPPORT_OPP_FIELD=

# Optional: which Deal Support fields to show, comma-separated API names (default: its page layout)
SF_DEAL_SUPPORT_FIELDS=

# Microsoft 365 calendar through Microsoft Graph: SailPoint's SF Desk app registration and tenant
# (see docs/SECURITY.md), read on the Mac too, and Deal Support categories added to meetings in Outlook
SF_DESK_GRAPH_CLIENT_ID=7fa312ab-5012-408c-9ab8-f6ca82489fbb
SF_DESK_GRAPH_TENANT=9c848b2a-49ba-4c39-9749-118d06717a84
SF_DESK_GRAPH=1
SF_DESK_OUTLOOK_MARK=1
